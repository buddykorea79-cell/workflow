# Copy to .env.local for this prototype. Keep real values out of Git.
DATABASE_URL=
# Neon Auth is not needed for the prototype's role picker.
NEON_AUTH_BASE_URL=
NEON_AUTH_USER_MAP=
IEUM_WORKSPACE_ID=development
# Hosted role picker: true on Vercel, with a random session secret (32+ chars).
IEUM_PROTOTYPE_MODE=false
IEUM_SESSION_SECRET=
IEUM_APP_ORIGIN=
IEUM_DATA_DIR=

# Neon Console > Connect > Storage > Parameters only.
# Use neon after filling all AWS_* values; local keeps files on this computer.
IEUM_STORAGE_PROVIDER=local
IEUM_STORAGE_BUCKET=ieum-attachments
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Explicit migration/seed acknowledgement; do not enable against live data.
IEUM_ALLOW_DEMO_SEED=false

# Server-side BizRouter procedure analysis (https://bizrouter.ai/docs/chat-completions).
# Never prefix secrets with NEXT_PUBLIC_.
BIZROUTER_API_KEY=
# Set an allowed concrete model ID from GET /v1/models with json_schema support.
BIZROUTER_MODEL=bizrouter/deepseek-v4.1-flash
# Server-side National Law Information Center search/article lookup.
# open.law.go.kr > My Page > API authentication key management (OC).
# Request law + administrative-rule list/body JSON access; redeploy after setting.
# Never use NEXT_PUBLIC_ or substitute data.go.kr's serviceKey. See docs/LAW-API-SETUP.md.
LAW_API_OC=
