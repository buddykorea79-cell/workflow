{
  "name": "ieum-workspace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "qa:serve": "node scripts/qa-serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "neon:check": "node --env-file=.env.local --import tsx scripts/check-neon.ts",
    "neon:files:check": "node --env-file=.env.local --import tsx scripts/check-neon-files.ts",
    "bizrouter:check": "node --env-file=.env.local --import tsx scripts/check-bizrouter.ts",
    "neon:import": "node --env-file=.env.local --import tsx scripts/import-local-neon.ts",
    "neon:import:apply": "node --env-file=.env.local --import tsx scripts/import-local-neon.ts --apply",
    "neon:storage:setup": "node --env-file=.env.local --import tsx scripts/setup-neon-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@xyflow/react": "^12.10.0",
    "drizzle-orm": "^0.45.0",
    "exceljs": "^4.4.0",
    "kordoc": "^4.24.47",
    "lucide-react": "^0.577.0",
    "next": "16.4.3",
    "pdfjs-dist": "6.4.299",
    "pdfkit": "^0.20.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.0",
    "ws": "^8.19.0",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^24.10.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "tailwindcss": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
